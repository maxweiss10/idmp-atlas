   "processed": "<!-- Kocher / Caird interactive UI — wider, compact tiles, no horizontal scroll --><style>\n/* Wider layout, compact tiles */\n.kocher-caird {\n  --idmp-blue: #1369b0;\n  --muted: #6b7785;\n  --border: #d6dee9;\n  font-family: Arial, Helvetica, sans-serif;\n  max-width: 1200px;            /* wider widget */\n  margin: 0.5rem auto;\n  color: #1f2d3d;\n  background: #fff;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  overflow: visible;\n  box-sizing: border-box;\n}\n\n/* ensure tall modal content scrolls rather than overflow the viewport */\n.ui-dialog .ui-dialog-content {\n  max-height: 88vh !important;\n  overflow: auto !important;\n  -webkit-overflow-scrolling: touch;\n}\n\n/* header */\n.kocher-caird .kc-head {\n  background: #f6fbff;\n  border-bottom: 1px solid var(--border);\n  padding: 14px 16px;\n}\n.kocher-caird h2 { margin:0; color:var(--idmp-blue); font-size:1.05rem; }\n.kocher-caird .kc-intro { margin-top:6px; color:var(--muted); font-size:0.92rem; }\n\n/* grid: left wide, right fixed */\n.kocher-caird .kc-grid {\n  display: grid;\n  grid-template-columns: 1fr 520px; /* right column fixed to 520px */\n  gap: 16px;\n  padding: 12px 14px 18px 14px;\n  box-sizing: border-box;\n}\n@media (max-width:1080px) {\n  .kocher-caird .kc-grid { grid-template-columns: 1fr; }\n}\n\n/* LEFT (compact checkbox card) */\n.kc-left { display:flex; flex-direction:column; gap:10px; }\n.kc-criteria-card {\n  border: 1px solid var(--border);\n  background: #fbfdff;\n  padding: 10px;\n  border-radius: 6px;\n}\n.kc-criteria-title { font-weight:700; margin-bottom:6px; color:#163247; }\n.kc-criteria { display:grid; grid-template-columns: repeat(2, 1fr); gap:8px; }\n@media (max-width:520px) { .kc-criteria { grid-template-columns: 1fr; } }\n\n/* compact tile */\n.kc-tile {\n  display:flex; align-items:center; gap:10px; padding:8px; border-radius:6px;\n  background:white; border:1px solid #eef4fb; cursor:pointer;\n}\n.kc-tile:hover { box-shadow: 0 3px 8px rgba(20,30,40,0.05); transform: none; }\n.kc-tile .kc-chk { width:22px; height:22px; min-width:22px; border-radius:6px;\n  display:inline-flex; align-items:center; justify-content:center; background:#fff; border:1px solid #f0a63b; color:#fff; font-weight:700; font-size:14px; }\n.kc-tile input[type=\"checkbox\"] { display:none; }\n.kc-tile.checked { background: linear-gradient(180deg,#fffaf1,#fff8f1); border-color:#f0a63b; }\n.kc-tile.checked .kc-chk { background:#f0a63b; color:white; }\n.kc-tile.full { grid-column: 1 / -1; padding:8px 10px; }\n\n/* make label text slightly smaller to fit */\n.kc-tile div { font-size:0.95rem; line-height:1.15; }\n\n/* controls */\n.kc-controls { display:flex; gap:10px; align-items:center; margin-top:6px; flex-wrap:wrap; }\n.kc-btn { background:var(--idmp-blue); color:#fff; padding:9px 14px; border-radius:6px; border:0; cursor:pointer; font-weight:700; }\n.kc-link { background:#fff; border:1px solid var(--border); padding:8px 12px; border-radius:6px; color:var(--idmp-blue); cursor:pointer; }\n\n/* RIGHT (table + results) */\n.kc-right { border-left:1px solid var(--border); padding-left:14px; display:flex; flex-direction:column; gap:12px; }\n\n/* table now allowed to expand to fit right column (no horizontal scrolling) */\n.kc-table { width:100%; border-collapse:collapse; font-size:0.95rem; }\n.kc-table th, .kc-table td { border:1px solid var(--border); padding:10px 12px; text-align:center; vertical-align:middle; }\n.kc-table th { background:#f0f6fb; color:#163247; font-weight:700; font-size:0.95rem; }\n.kc-table .leftcol { text-align:left; font-weight:700; background:#fbfdff; }\n.kc-table tr.alt td { background: #fbfdff; }\n\n/* result box */\n.kc-result { background:#fff; border:1px solid var(--border); padding:10px; border-radius:6px; }\n.kc-counters { display:flex; gap:18px; align-items:baseline; flex-wrap:wrap; }\n.kc-counters .count { font-size:1.2rem; font-weight:700; color:var(--idmp-blue); }\n.kc-pct { font-size:1rem; font-weight:700; color:var(--idmp-blue); }\n.kc-note { color:var(--muted); font-size:0.9rem; margin-top:6px; }\n\n[aria-hidden=\"true\"] { display:none !important; }\n</style><div class=\"kocher-caird\" role=\"region\" aria-labelledby=\"kc-title\"><div class=\"kc-head\"><h2 id=\"kc-title\">Kocher / Caird Criteria — Interactive</h2><div class=\"kc-intro\">Classic Kocher 4 risk factors for hip ABA. Caird added CRP &gt; 2 mg/dL as a 5th risk factor. Select boxes to show probabilities.</div></div><div class=\"kc-grid\"><!-- LEFT --><div class=\"kc-left\"><div class=\"kc-criteria-card\" id=\"kc-card\"><div class=\"kc-criteria-title\">Check present risk factors</div><div style=\"color:var(--muted);font-size:0.92rem;margin-bottom:6px;\" id=\"kc-desc\">(Classic Kocher = first 4. CRP is Caird's 5th risk factor.)</div><div class=\"kc-criteria\" id=\"kc-tiles\"><p><label class=\"kc-tile\" data-for=\"kc-fever\" tabindex=\"0\"><span class=\"kc-chk\">✓</span>&nbsp;</label></p><div><div><label class=\"kc-tile\" data-for=\"kc-fever\" tabindex=\"0\"><strong>Fever &gt; 38.5 °C</strong></label></div></div><p><label class=\"kc-tile\" data-for=\"kc-nonweight\" tabindex=\"0\"><span class=\"kc-chk\">✓</span>&nbsp;</label></p><div><div><label class=\"kc-tile\" data-for=\"kc-nonweight\" tabindex=\"0\"><strong>Non–weight bearing</strong></label></div></div><p><label class=\"kc-tile\" data-for=\"kc-wbc\" tabindex=\"0\"><span class=\"kc-chk\">✓</span>&nbsp;</label></p><div><div><label class=\"kc-tile\" data-for=\"kc-wbc\" tabindex=\"0\"><strong>WBC &gt; 12,000 /µL</strong></label></div></div><p><label class=\"kc-tile\" data-for=\"kc-esr\" tabindex=\"0\"><span class=\"kc-chk\">✓</span>&nbsp;</label></p><div><div><label class=\"kc-tile\" data-for=\"kc-esr\" tabindex=\"0\"><strong>ESR &gt; 40 mm/hr</strong></label></div></div><p><label class=\"kc-tile full\" data-for=\"kc-crp\" tabindex=\"0\" title=\"Caird: CRP &gt; 2 mg/dL\"><span class=\"kc-chk\">✓</span>&nbsp;</label></p><div><div><label class=\"kc-tile full\" data-for=\"kc-crp\" tabindex=\"0\" title=\"Caird: CRP &gt; 2 mg/dL\"><strong>CRP &gt; 2 mg/dL (Caird)</strong></label></div><div style=\"color:var(--muted);font-size:0.86rem;margin-top:4px;\"><label class=\"kc-tile full\" data-for=\"kc-crp\" tabindex=\"0\" title=\"Caird: CRP &gt; 2 mg/dL\">(optional)</label></div></div></div><div class=\"kc-controls\"><p><button class=\"kc-btn\" type=\"button\" id=\"kc-calc\">Show probabilities</button> <button class=\"kc-link\" type=\"button\" id=\"kc-reset\">Reset</button></p><div style=\"color:var(--muted);font-size:0.9rem;margin-left:auto;\">Use clinical judgment — study-derived estimates only.</div></div></div></div><!-- RIGHT --><div class=\"kc-right\" aria-live=\"polite\"><table class=\"kc-table\" role=\"table\" aria-label=\"Kocher and Caird probability table\"><thead><tr><th class=\"leftcol\">Number of RF Present</th><th>Retrospective cohort<br>(Kocher)</th><th>Prospective cohort<br>(Kocher)</th><th>CRP added as RF<br>(Caird)</th></tr></thead><tbody><tr><td class=\"leftcol\">0</td><td id=\"ret-0\">0.2%</td><td id=\"pros-0\">2%</td><td id=\"crp-0\">16.9%</td></tr><tr class=\"alt\"><td class=\"leftcol\">1</td><td id=\"ret-1\">3%</td><td id=\"pros-1\">9.5%</td><td id=\"crp-1\">36.7%</td></tr><tr><td class=\"leftcol\">2</td><td id=\"ret-2\">40%</td><td id=\"pros-2\">35%</td><td id=\"crp-2\">62.4%</td></tr><tr class=\"alt\"><td class=\"leftcol\">3</td><td id=\"ret-3\">93%</td><td id=\"pros-3\">72.8%</td><td id=\"crp-3\">82.6%</td></tr><tr><td class=\"leftcol\">4</td><td id=\"ret-4\">99.6%</td><td id=\"pros-4\">93%</td><td id=\"crp-4\">93.1%</td></tr><tr class=\"alt\"><td class=\"leftcol\">5</td><td id=\"ret-5\">99.6%</td><td id=\"pros-5\">93%</td><td id=\"crp-5\">97.5%</td></tr></tbody></table><div class=\"kc-result\" id=\"kc-result\" aria-hidden=\"true\"><div class=\"kc-counters\"><div><div style=\"color:var(--muted);font-size:0.86rem;\">Selected (classic Kocher)</div><div class=\"count\" id=\"kc-classic-count\">—</div></div><div><div style=\"color:var(--muted);font-size:0.86rem;\">Selected (including CRP)</div><div class=\"count\" id=\"kc-crp-count\">—</div></div></div><div style=\"margin-top:8px;\"><div style=\"color:var(--muted);font-size:0.92rem;\">Estimated probabilities:</div><div style=\"margin-top:8px;\"><div><strong>Retrospective (Kocher):</strong> <span class=\"kc-pct\" id=\"kc-ret-pct\">—</span></div><div><strong>Prospective (Kocher):</strong> <span class=\"kc-pct\" id=\"kc-pros-pct\">—</span></div><div><strong>CRP-as-RF (Caird):</strong> <span class=\"kc-pct\" id=\"kc-crp-pct\">—</span></div></div></div><div class=\"kc-note\" id=\"kc-note\">Note: Probabilities are from Kocher/Caird studies and are estimates only.</div></div></div></div></div><script>\n(function () {\n  const retrospective = {0: 0.2, 1:3, 2:40, 3:93, 4:99.6, 5:99.6};\n  const prospective   = {0: 2, 1:9.5, 2:35, 3:72.8, 4:93, 5:93};\n  const crpAdded      = {0:16.9,1:36.7,2:62.4,3:82.6,4:93.1,5:97.5};\n\n  const btnCalc = document.getElementById('kc-calc');\n  const btnReset = document.getElementById('kc-reset');\n  const resultBox = document.getElementById('kc-result');\n  const elClassicCount = document.getElementById('kc-classic-count');\n  const elCrpCount = document.getElementById('kc-crp-count');\n  const elRetPct = document.getElementById('kc-ret-pct');\n  const elProsPct = document.getElementById('kc-pros-pct');\n  const elCrpPct = document.getElementById('kc-crp-pct');\n\n  const ids = ['kc-fever','kc-nonweight','kc-wbc','kc-esr','kc-crp'];\n  const tileEls = document.querySelectorAll('.kc-tile');\n  const checked = new Map(); ids.forEach(id => checked.set(id,false));\n\n  tileEls.forEach(function(tile){\n    const forId = tile.getAttribute('data-for');\n    tile.addEventListener('click', function(){ toggle(forId, tile); });\n    tile.addEventListener('keydown', function(e){\n      if(e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar'){ e.preventDefault(); toggle(forId, tile); }\n    });\n  });\n\n  function toggle(id, tileEl){\n    const newVal = !checked.get(id);\n    checked.set(id, newVal);\n    tileEl.classList.toggle('checked', newVal);\n    let hidden = document.getElementById(id);\n    if(!hidden){\n      hidden = document.createElement('input');\n      hidden.type = 'checkbox';\n      hidden.id = id;\n      hidden.style.display = 'none';\n      document.getElementById('kc-card').appendChild(hidden);\n    }\n    hidden.checked = newVal;\n  }\n\n  function getCounts(){\n    const fever = document.getElementById('kc-fever') && document.getElementById('kc-fever').checked ? 1:0;\n    const nonw = document.getElementById('kc-nonweight') && document.getElementById('kc-nonweight').checked ? 1:0;\n    const wbc = document.getElementById('kc-wbc') && document.getElementById('kc-wbc').checked ? 1:0;\n    const esr = document.getElementById('kc-esr') && document.getElementById('kc-esr').checked ? 1:0;\n    const crp = document.getElementById('kc-crp') && document.getElementById('kc-crp').checked ? 1:0;\n    const classic = fever + nonw + wbc + esr;\n    const withCrp = classic + crp;\n    return {classic: Math.min(Math.max(classic,0),4), withCrp: Math.min(Math.max(withCrp,0),5)};\n  }\n\n  function showResults(){\n    const counts = getCounts();\n    const classic = counts.classic;\n    const withCrp = counts.withCrp;\n    const ret = retrospective[classic] !== undefined ? retrospective[classic] : retrospective[4];\n    const pros = prospective[classic] !== undefined ? prospective[classic] : prospective[4];\n    const crp = crpAdded[withCrp] !== undefined ? crpAdded[withCrp] : crpAdded[5];\n\n    elClassicCount.textContent = classic;\n    elCrpCount.textContent = withCrp;\n    elRetPct.textContent = ret + '%';\n    elProsPct.textContent = pros + '%';\n    elCrpPct.textContent = crp + '%';\n\n    resultBox.setAttribute('aria-hidden','false');\n    resultBox.style.display = 'block';\n    if (typeof jQuery !== 'undefined' && jQuery('.ui-dialog:visible').length) {\n      const $dlg = jQuery('.ui-dialog:visible').last();\n      $dlg.find('.kc-result')[0]?.scrollIntoView({behavior:'smooth', block:'nearest'});\n    }\n  }\n\n  function resetAll(){\n    ids.forEach(id => checked.set(id,false));\n    tileEls.forEach(t => t.classList.remove('checked'));\n    ids.forEach(id => { const el = document.getElementById(id); if(el) el.checked = false; });\n    resultBox.setAttribute('aria-hidden','true');\n    resultBox.style.display = 'none';\n    elClassicCount.textContent = '—';\n    elCrpCount.textContent = '—';\n    elRetPct.textContent = '—';\n    elProsPct.textContent = '—';\n    elCrpPct.textContent = '—';\n  }\n\n  btnCalc.addEventListener('click', showResults);\n  btnReset.addEventListener('click', resetAll);\n  resetAll();\n})();\n</script>",
   "value": "<!-- Kocher / Caird interactive UI — wider, compact tiles, no horizontal scroll --><style>\r\n/* Wider layout, compact tiles */\r\n.kocher-caird {\r\n  --idmp-blue: #1369b0;\r\n  --muted: #6b7785;\r\n  --border: #d6dee9;\r\n  font-family: Arial, Helvetica, sans-serif;\r\n  max-width: 1200px;            /* wider widget */\r\n  margin: 0.5rem auto;\r\n  color: #1f2d3d;\r\n  background: #fff;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  overflow: visible;\r\n  box-sizing: border-box;\r\n}\r\n\r\n/* ensure tall modal content scrolls rather than overflow the viewport */\r\n.ui-dialog .ui-dialog-content {\r\n  max-height: 88vh !important;\r\n  overflow: auto !important;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n/* header */\r\n.kocher-caird .kc-head {\r\n  background: #f6fbff;\r\n  border-bottom: 1px solid var(--border);\r\n  padding: 14px 16px;\r\n}\r\n.kocher-caird h2 { margin:0; color:var(--idmp-blue); font-size:1.05rem; }\r\n.kocher-caird .kc-intro { margin-top:6px; color:var(--muted); font-size:0.92rem; }\r\n\r\n/* grid: left wide, right fixed */\r\n.kocher-caird .kc-grid {\r\n  display: grid;\r\n  grid-template-columns: 1fr 520px; /* right column fixed to 520px */\r\n  gap: 16px;\r\n  padding: 12px 14px 18px 14px;\r\n  box-sizing: border-box;\r\n}\r\n@media (max-width:1080px) {\r\n  .kocher-caird .kc-grid { grid-template-columns: 1fr; }\r\n}\r\n\r\n/* LEFT (compact checkbox card) */\r\n.kc-left { display:flex; flex-direction:column; gap:10px; }\r\n.kc-criteria-card {\r\n  border: 1px solid var(--border);\r\n  background: #fbfdff;\r\n  padding: 10px;\r\n  border-radius: 6px;\r\n}\r\n.kc-criteria-title { font-weight:700; margin-bottom:6px; color:#163247; }\r\n.kc-criteria { display:grid; grid-template-columns: repeat(2, 1fr); gap:8px; }\r\n@media (max-width:520px) { .kc-criteria { grid-template-columns: 1fr; } }\r\n\r\n/* compact tile */\r\n.kc-tile {\r\n  display:flex; align-items:center; gap:10px; padding:8px; border-radius:6px;\r\n  background:white; border:1px solid #eef4fb; cursor:pointer;\r\n}\r\n.kc-tile:hover { box-shadow: 0 3px 8px rgba(20,30,40,0.05); transform: none; }\r\n.kc-tile .kc-chk { width:22px; height:22px; min-width:22px; border-radius:6px;\r\n  display:inline-flex; align-items:center; justify-content:center; background:#fff; border:1px solid #f0a63b; color:#fff; font-weight:700; font-size:14px; }\r\n.kc-tile input[type=\"checkbox\"] { display:none; }\r\n.kc-tile.checked { background: linear-gradient(180deg,#fffaf1,#fff8f1); border-color:#f0a63b; }\r\n.kc-tile.checked .kc-chk { background:#f0a63b; color:white; }\r\n.kc-tile.full { grid-column: 1 / -1; padding:8px 10px; }\r\n\r\n/* make label text slightly smaller to fit */\r\n.kc-tile div { font-size:0.95rem; line-height:1.15; }\r\n\r\n/* controls */\r\n.kc-controls { display:flex; gap:10px; align-items:center; margin-top:6px; flex-wrap:wrap; }\r\n.kc-btn { background:var(--idmp-blue); color:#fff; padding:9px 14px; border-radius:6px; border:0; cursor:pointer; font-weight:700; }\r\n.kc-link { background:#fff; border:1px solid var(--border); padding:8px 12px; border-radius:6px; color:var(--idmp-blue); cursor:pointer; }\r\n\r\n/* RIGHT (table + results) */\r\n.kc-right { border-left:1px solid var(--border); padding-left:14px; display:flex; flex-direction:column; gap:12px; }\r\n\r\n/* table now allowed to expand to fit right column (no horizontal scrolling) */\r\n.kc-table { width:100%; border-collapse:collapse; font-size:0.95rem; }\r\n.kc-table th, .kc-table td { border:1px solid var(--border); padding:10px 12px; text-align:center; vertical-align:middle; }\r\n.kc-table th { background:#f0f6fb; color:#163247; font-weight:700; font-size:0.95rem; }\r\n.kc-table .leftcol { text-align:left; font-weight:700; background:#fbfdff; }\r\n.kc-table tr.alt td { background: #fbfdff; }\r\n\r\n/* result box */\r\n.kc-result { background:#fff; border:1px solid var(--border); padding:10px; border-radius:6px; }\r\n.kc-counters { display:flex; gap:18px; align-items:baseline; flex-wrap:wrap; }\r\n.kc-counters .count { font-size:1.2rem; font-weight:700; color:var(--idmp-blue); }\r\n.kc-pct { font-size:1rem; font-weight:700; color:var(--idmp-blue); }\r\n.kc-note { color:var(--muted); font-size:0.9rem; margin-top:6px; }\r\n\r\n[aria-hidden=\"true\"] { display:none !important; }\r\n</style><div class=\"kocher-caird\" role=\"region\" aria-labelledby=\"kc-title\"><div class=\"kc-head\"><h2 id=\"kc-title\">Kocher / Caird Criteria — Interactive</h2><div class=\"kc-intro\">Classic Kocher 4 risk factors for hip ABA. Caird added CRP &gt; 2 mg/dL as a 5th risk factor. Select boxes to show probabilities.</div></div><div class=\"kc-grid\"><!-- LEFT --><div class=\"kc-left\"><div class=\"kc-criteria-card\" id=\"kc-card\"><div class=\"kc-criteria-title\">Check present risk factors</div><div style=\"color:var(--muted);font-size:0.92rem;margin-bottom:6px;\" id=\"kc-desc\">(Classic Kocher = first 4. CRP is Caird's 5th risk factor.)</div><div class=\"kc-criteria\" id=\"kc-tiles\"><p><label class=\"kc-tile\" data-for=\"kc-fever\" tabindex=\"0\"><span class=\"kc-chk\">✓</span>&nbsp;</label></p><div><div><label class=\"kc-tile\" data-for=\"kc-fever\" tabindex=\"0\"><strong>Fever &gt; 38.5 °C</strong></label></div></div><p><label class=\"kc-tile\" data-for=\"kc-nonweight\" tabindex=\"0\"><span class=\"kc-chk\">✓</span>&nbsp;</label></p><div><div><label class=\"kc-tile\" data-for=\"kc-nonweight\" tabindex=\"0\"><strong>Non–weight bearing</strong></label></div></div><p><label class=\"kc-tile\" data-for=\"kc-wbc\" tabindex=\"0\"><span class=\"kc-chk\">✓</span>&nbsp;</label></p><div><div><label class=\"kc-tile\" data-for=\"kc-wbc\" tabindex=\"0\"><strong>WBC &gt; 12,000 /µL</strong></label></div></div><p><label class=\"kc-tile\" data-for=\"kc-esr\" tabindex=\"0\"><span class=\"kc-chk\">✓</span>&nbsp;</label></p><div><div><label class=\"kc-tile\" data-for=\"kc-esr\" tabindex=\"0\"><strong>ESR &gt; 40 mm/hr</strong></label></div></div><p><label class=\"kc-tile full\" data-for=\"kc-crp\" tabindex=\"0\" title=\"Caird: CRP &gt; 2 mg/dL\"><span class=\"kc-chk\">✓</span>&nbsp;</label></p><div><div><label class=\"kc-tile full\" data-for=\"kc-crp\" tabindex=\"0\" title=\"Caird: CRP &gt; 2 mg/dL\"><strong>CRP &gt; 2 mg/dL (Caird)</strong></label></div><div style=\"color:var(--muted);font-size:0.86rem;margin-top:4px;\"><label class=\"kc-tile full\" data-for=\"kc-crp\" tabindex=\"0\" title=\"Caird: CRP &gt; 2 mg/dL\">(optional)</label></div></div></div><div class=\"kc-controls\"><p><button class=\"kc-btn\" type=\"button\" id=\"kc-calc\">Show probabilities</button> <button class=\"kc-link\" type=\"button\" id=\"kc-reset\">Reset</button></p><div style=\"color:var(--muted);font-size:0.9rem;margin-left:auto;\">Use clinical judgment — study-derived estimates only.</div></div></div></div><!-- RIGHT --><div class=\"kc-right\" aria-live=\"polite\"><table class=\"kc-table\" role=\"table\" aria-label=\"Kocher and Caird probability table\"><thead><tr><th class=\"leftcol\">Number of RF Present</th><th>Retrospective cohort<br>(Kocher)</th><th>Prospective cohort<br>(Kocher)</th><th>CRP added as RF<br>(Caird)</th></tr></thead><tbody><tr><td class=\"leftcol\">0</td><td id=\"ret-0\">0.2%</td><td id=\"pros-0\">2%</td><td id=\"crp-0\">16.9%</td></tr><tr class=\"alt\"><td class=\"leftcol\">1</td><td id=\"ret-1\">3%</td><td id=\"pros-1\">9.5%</td><td id=\"crp-1\">36.7%</td></tr><tr><td class=\"leftcol\">2</td><td id=\"ret-2\">40%</td><td id=\"pros-2\">35%</td><td id=\"crp-2\">62.4%</td></tr><tr class=\"alt\"><td class=\"leftcol\">3</td><td id=\"ret-3\">93%</td><td id=\"pros-3\">72.8%</td><td id=\"crp-3\">82.6%</td></tr><tr><td class=\"leftcol\">4</td><td id=\"ret-4\">99.6%</td><td id=\"pros-4\">93%</td><td id=\"crp-4\">93.1%</td></tr><tr class=\"alt\"><td class=\"leftcol\">5</td><td id=\"ret-5\">99.6%</td><td id=\"pros-5\">93%</td><td id=\"crp-5\">97.5%</td></tr></tbody></table><div class=\"kc-result\" id=\"kc-result\" aria-hidden=\"true\"><div class=\"kc-counters\"><div><div style=\"color:var(--muted);font-size:0.86rem;\">Selected (classic Kocher)</div><div class=\"count\" id=\"kc-classic-count\">—</div></div><div><div style=\"color:var(--muted);font-size:0.86rem;\">Selected (including CRP)</div><div class=\"count\" id=\"kc-crp-count\">—</div></div></div><div style=\"margin-top:8px;\"><div style=\"color:var(--muted);font-size:0.92rem;\">Estimated probabilities:</div><div style=\"margin-top:8px;\"><div><strong>Retrospective (Kocher):</strong> <span class=\"kc-pct\" id=\"kc-ret-pct\">—</span></div><div><strong>Prospective (Kocher):</strong> <span class=\"kc-pct\" id=\"kc-pros-pct\">—</span></div><div><strong>CRP-as-RF (Caird):</strong> <span class=\"kc-pct\" id=\"kc-crp-pct\">—</span></div></div></div><div class=\"kc-note\" id=\"kc-note\">Note: Probabilities are from Kocher/Caird studies and are estimates only.</div></div></div></div></div><script>\r\n(function () {\r\n  const retrospective = {0: 0.2, 1:3, 2:40, 3:93, 4:99.6, 5:99.6};\r\n  const prospective   = {0: 2, 1:9.5, 2:35, 3:72.8, 4:93, 5:93};\r\n  const crpAdded      = {0:16.9,1:36.7,2:62.4,3:82.6,4:93.1,5:97.5};\r\n\r\n  const btnCalc = document.getElementById('kc-calc');\r\n  const btnReset = document.getElementById('kc-reset');\r\n  const resultBox = document.getElementById('kc-result');\r\n  const elClassicCount = document.getElementById('kc-classic-count');\r\n  const elCrpCount = document.getElementById('kc-crp-count');\r\n  const elRetPct = document.getElementById('kc-ret-pct');\r\n  const elProsPct = document.getElementById('kc-pros-pct');\r\n  const elCrpPct = document.getElementById('kc-crp-pct');\r\n\r\n  const ids = ['kc-fever','kc-nonweight','kc-wbc','kc-esr','kc-crp'];\r\n  const tileEls = document.querySelectorAll('.kc-tile');\r\n  const checked = new Map(); ids.forEach(id => checked.set(id,false));\r\n\r\n  tileEls.forEach(function(tile){\r\n    const forId = tile.getAttribute('data-for');\r\n    tile.addEventListener('click', function(){ toggle(forId, tile); });\r\n    tile.addEventListener('keydown', function(e){\r\n      if(e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar'){ e.preventDefault(); toggle(forId, tile); }\r\n    });\r\n  });\r\n\r\n  function toggle(id, tileEl){\r\n    const newVal = !checked.get(id);\r\n    checked.set(id, newVal);\r\n    tileEl.classList.toggle('checked', newVal);\r\n    let hidden = document.getElementById(id);\r\n    if(!hidden){\r\n      hidden = document.createElement('input');\r\n      hidden.type = 'checkbox';\r\n      hidden.id = id;\r\n      hidden.style.display = 'none';\r\n      document.getElementById('kc-card').appendChild(hidden);\r\n    }\r\n    hidden.checked = newVal;\r\n  }\r\n\r\n  function getCounts(){\r\n    const fever = document.getElementById('kc-fever') && document.getElementById('kc-fever').checked ? 1:0;\r\n    const nonw = document.getElementById('kc-nonweight') && document.getElementById('kc-nonweight').checked ? 1:0;\r\n    const wbc = document.getElementById('kc-wbc') && document.getElementById('kc-wbc').checked ? 1:0;\r\n    const esr = document.getElementById('kc-esr') && document.getElementById('kc-esr').checked ? 1:0;\r\n    const crp = document.getElementById('kc-crp') && document.getElementById('kc-crp').checked ? 1:0;\r\n    const classic = fever + nonw + wbc + esr;\r\n    const withCrp = classic + crp;\r\n    return {classic: Math.min(Math.max(classic,0),4), withCrp: Math.min(Math.max(withCrp,0),5)};\r\n  }\r\n\r\n  function showResults(){\r\n    const counts = getCounts();\r\n    const classic = counts.classic;\r\n    const withCrp = counts.withCrp;\r\n    const ret = retrospective[classic] !== undefined ? retrospective[classic] : retrospective[4];\r\n    const pros = prospective[classic] !== undefined ? prospective[classic] : prospective[4];\r\n    const crp = crpAdded[withCrp] !== undefined ? crpAdded[withCrp] : crpAdded[5];\r\n\r\n    elClassicCount.textContent = classic;\r\n    elCrpCount.textContent = withCrp;\r\n    elRetPct.textContent = ret + '%';\r\n    elProsPct.textContent = pros + '%';\r\n    elCrpPct.textContent = crp + '%';\r\n\r\n    resultBox.setAttribute('aria-hidden','false');\r\n    resultBox.style.display = 'block';\r\n    if (typeof jQuery !== 'undefined' && jQuery('.ui-dialog:visible').length) {\r\n      const $dlg = jQuery('.ui-dialog:visible').last();\r\n      $dlg.find('.kc-result')[0]?.scrollIntoView({behavior:'smooth', block:'nearest'});\r\n    }\r\n  }\r\n\r\n  function resetAll(){\r\n    ids.forEach(id => checked.set(id,false));\r\n    tileEls.forEach(t => t.classList.remove('checked'));\r\n    ids.forEach(id => { const el = document.getElementById(id); if(el) el.checked = false; });\r\n    resultBox.setAttribute('aria-hidden','true');\r\n    resultBox.style.display = 'none';\r\n    elClassicCount.textContent = '—';\r\n    elCrpCount.textContent = '—';\r\n    elRetPct.textContent = '—';\r\n    elProsPct.textContent = '—';\r\n    elCrpPct.textContent = '—';\r\n  }\r\n\r\n  btnCalc.addEventListener('click', showResults);\r\n  btnReset.addEventListener('click', resetAll);\r\n  resetAll();\r\n})();\r\n</script>"
  }
 ],
